# Copy to .dev.vars for `wrangler dev`. Dummy values only; never commit .dev.vars.
# The signing key below is a THROWAWAY: generate one with
#   python tools/generate_keys.py --out /tmp/dev-keys.json --kid px1
# and never paste a production key here.
SIGNING_KEY_PX1="replace-with-a-throwaway-dev-seed"
FP_PEPPER="dev-only-fp-pepper"
IP_HASH_KEY="dev-only-ip-pepper"
ADMIN_TOKEN="dev-only-admin-token"
SESSION_KEY="dev-only-session-key"
PUBLIC_BASE_URL="http://127.0.0.1:8787"
