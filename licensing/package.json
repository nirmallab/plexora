{
  "name": "plexora-licensing",
  "version": "0.1.0",
  "private": true,
  "description": "Plexora's licence service: certificates, environments, tokens, trials, offline grants, the portal and admin, on one Cloudflare Worker.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:node": "vitest run --project node",
    "test:workers": "vitest run --project workers",
    "typecheck": "tsc --noEmit",
    "db:init": "wrangler d1 execute plexora-license --file=schema.sql --remote",
    "db:init:local": "wrangler d1 execute plexora-license --file=schema.sql --local"
  },
  "dependencies": {
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.12.0",
    "@cloudflare/workers-types": "^4.20250109.0",
    "@types/node": "^22.10.0",
    "@vitest/runner": "~2.1.8",
    "@vitest/snapshot": "~2.1.8",
    "typescript": "^5.7.2",
    "vitest": "~2.1.8",
    "wrangler": "^3.99.0"
  }
}
