{
  "name": "plexora-docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Plexora documentation site (static export for GitHub Pages). Never a runtime dependency of the Python package.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "generate:browser-api": "node scripts/generate_browser_api.mjs",
    "check:links": "node scripts/check_links.mjs",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "fumadocs-core": "16.15.15",
    "fumadocs-mdx": "15.4.5",
    "fumadocs-ui": "16.15.15",
    "lucide-react": "^1.48.0",
    "next": "^16.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.13",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.0",
    "postcss": "^8.5.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  }
}
