{
  "name": "plexora-telemetry",
  "version": "0.1.0",
  "private": true,
  "description": "Plexora's anonymous telemetry backend: ingest, fold, budget, archive and admin on one Cloudflare Worker.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:node": "vitest run --project node",
    "test:workers": "vitest run --project workers",
    "typecheck": "tsc --noEmit",
    "db:init": "wrangler d1 execute plexora-telemetry --file=schema.sql --remote",
    "db:init:local": "wrangler d1 execute plexora-telemetry --file=schema.sql --local"
  },
  "dependencies": {
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.23.0",
    "@cloudflare/workers-types": "^5.20261019.1",
    "@types/node": "^26.6.5",
    "@vitest/runner": "~4.1.11",
    "@vitest/snapshot": "~5.0.5",
    "typescript": "^7.0.2",
    "vitest": "~5.0.5",
    "wrangler": "^4.151.2"
  }
}
