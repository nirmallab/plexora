{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ES2022",
    "moduleResolution": "Bundler",
    // The Worker needs only the Cloudflare types; "node" is for the node-pool
    // tests that read the vectors and fixture from disk. The pool-workers types
    // supply `cloudflare:test`.
    "types": ["@cloudflare/workers-types", "node", "@cloudflare/vitest-pool-workers"],
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "resolveJsonModule": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "test/**/*.ts", "*.ts"]
}
