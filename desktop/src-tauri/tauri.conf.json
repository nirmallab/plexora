{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Plexora",
  "version": "0.0.32",
  "identifier": "com.biocognia.plexora",
  "mainBinaryName": "plexora-desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "app", "deb"],
    "createUpdaterArtifacts": false,
    "publisher": "BioCognia",
    "homepage": "https://github.com/nirmallab/plexora",
    "category": "Education",
    "shortDescription": "Multiplexed and spatial image viewer",
    "longDescription": "Plexora views and analyses multiplexed tissue images, whole slides and spatial transcriptomics on your own computer.",
    "copyright": "BioCognia",
    "license": "LicenseRef-Plexora-EULA-1.0",
    "licenseFile": "../../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {},
    "fileAssociations": [
      { "ext": ["qptiff"], "name": "QPTIFF image", "role": "Viewer", "mimeType": "image/tiff" },
      { "ext": ["svs"], "name": "Aperio slide", "role": "Viewer" },
      { "ext": ["ndpi"], "name": "Hamamatsu slide", "role": "Viewer" },
      { "ext": ["scn"], "name": "Leica slide", "role": "Viewer" },
      { "ext": ["mrxs"], "name": "MIRAX slide", "role": "Viewer" },
      { "ext": ["h5ad"], "name": "AnnData table", "role": "Viewer" }
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "12.0",
      "entitlements": "entitlements.plist",
      "signingIdentity": "-",
      "hardenedRuntime": true
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["plexora"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMyQjAwN0JDQzk2Q0ZFQTYKUldTbS9tekp2QWV3d3NVNWNaQmxyVXlZZHFKSVdndzFLd1lkRTgyblR4Tk5LSlA3VlFKVjlaUXoK",
      "endpoints": ["https://github.com/nirmallab/plexora/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
