# Scratch notebooks. tests/testing_notebook.ipynb was tracked with absolute
# local paths and stored outputs; it is a scratchpad, not part of the suite.
*.ipynb

# Local virtualenv.
.venv/

# Planning scratch: a design review of the core/plugin boundary and the prompt
# that produced it. Working notes, not part of the shipped repo.
BRANCHING_REVIEW.md
BRANCHING_REVIEW_PROMPT.md

# Test scratch: the plugin-boundary probe writes a throwaway config here.
tmp/
pytest_output.txt
pytest_full_output.txt

# The desktop app. scripts/release.py keeps its build products outside a synced
# repository; these are where they land when it is not synced, plus the Tauri
# CLI and the schemas tauri-build regenerates on every build.
desktop/node_modules/
desktop/src-tauri/target/
desktop/src-tauri/gen/
desktop/runtime/
/release/
# setuptools' sdist staging directory, left behind when a sync client holds a
# file open while `uv build` tries to delete it.
/plexora-[0-9]*/
